# Copy this file to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=4000
# Local PostgreSQL 18 (replace YOUR_PASSWORD with the postgres user's password)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/speaksafe?schema=public"
# Frontend address allowed to call the API
CLIENT_ORIGIN=http://localhost:5173
# Long random string used to sign/HMAC server-side values (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SERVER_SECRET=change-me-to-a-long-random-hex-string
