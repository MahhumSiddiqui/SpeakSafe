// SpeakSafe database schema (SRS Section 3.4)
// Sensitive content is stored ONLY as ciphertext produced in the browser.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  HANDLER
  ADMIN
}

enum ReportMode {
  ANONYMOUS
  CONFIDENTIAL
  NAMED
}

enum CaseStatus {
  RECEIVED
  UNDER_REVIEW
  INQUIRY
  PENDING_CLOSURE
  CLOSED
}

enum SenderType {
  REPORTER
  HANDLER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- Staff (handlers and admin) ----------
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  displayName         String
  role                Role
  active              Boolean   @default(true)
  passwordHash        String // Argon2id
  publicKey           String? // X25519, base64 (handlers only)
  encryptedPrivateKey String? // encrypted in the browser before upload
  keySalt             String?
  createdAt           DateTime  @default(now())
  lastLoginAt         DateTime?
  mustChangePassword  Boolean   @default(false) // set for one-time passwords issued by the admin

  mfa              MfaFactor?
  sessions         Session[]
  reportKeys       ReportKey[]
  assignedCases    Case[]            @relation("AssignedHandler")
  exclusions       Exclusion[]
  recusals         Recusal[]
  notes            CaseNote[]
  messages         Message[]
  closureRequests  ClosureApproval[] @relation("Requester")
  closureApprovals ClosureApproval[] @relation("Approver")
}

model MfaFactor {
  id            String   @id @default(uuid())
  userId        String   @unique
  secretEnc     String // TOTP secret, encrypted at rest with SERVER_SECRET
  confirmed     Boolean  @default(false)
  recoveryCodes String[] // Argon2id hashes, single use
  lastUsedStep  Int? // last accepted 30-second TOTP step: stops a code being replayed
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String   @id // SHA-256 of the session token (raw token only in the cookie)
  userId     String
  csrfToken  String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  active Boolean @default(true)
  cases  Case[]
}

// ---------- Reporter "private space" accounts ----------
// No email, phone or real name. Keys are derived and used only in the browser;
// the server stores verifiers and ciphertext it cannot open.
model ReporterAccount {
  id                String            @id @default(uuid())
  username          String            @unique // made-up name, lower case
  pwSalt            String // salt for the browser's Argon2id (base64)
  authHash          String // server-side Argon2id hash of the browser's auth key
  masterKeyEnc      String // account master key, encrypted with the password-derived key
  recSalt           String // salt for the recovery words
  recAuthHash       String // server-side Argon2id hash of the recovery auth key
  masterKeyRecEnc   String // master key, encrypted with the recovery-words key
  publicKey         String // X25519 public key: committee replies are sealed to this
  secretKeyEnc      String // X25519 secret key, encrypted with the master key
  createdAt         DateTime          @default(now())
  passwordChangedAt DateTime          @default(now())
  // Encrypted (master key) list of this person's cases. The database itself has NO link between
  // an account and its cases, so even someone reading the database cannot tell who filed what.
  vaultEnc          String?
  sessions          ReporterSession[]
  draft             ReporterDraft?
  draftFiles        DraftFile[]
  journalEntries    JournalEntry[]
  lockerFiles       LockerFile[]
}

model ReporterSession {
  id         String          @id // SHA-256 of the session token (raw token only in the cookie)
  accountId  String
  csrfToken  String
  createdAt  DateTime        @default(now())
  lastSeenAt DateTime        @default(now())
  expiresAt  DateTime
  account    ReporterAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// One unfinished report per account, encrypted with the account's master key.
model ReporterDraft {
  accountId  String          @id
  ciphertext String
  updatedAt  DateTime        @updatedAt
  account    ReporterAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// Evidence and voice notes added to a draft (encrypted with the master key). Deleted after sending.
model DraftFile {
  id         String          @id @default(uuid())
  accountId  String
  ciphertext Bytes
  size       Int
  createdAt  DateTime        @default(now())
  account    ReporterAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// ---------- Private journal and evidence locker ----------
// Belongs to the reporter's private space; encrypted with the account's master key in the browser.
// Unlike reports, the reporter may edit and delete their own journal and locker (these are private notes).
model JournalEntry {
  id         String          @id @default(uuid())
  accountId  String
  ciphertext String // date, text, place and linked locker files, as encrypted JSON
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  account    ReporterAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model LockerFile {
  id         String          @id @default(uuid())
  accountId  String
  meta       String // kind, type, label, length: encrypted JSON
  ciphertext Bytes // metadata stripped, then encrypted in the browser
  size       Int
  createdAt  DateTime        @default(now())
  account    ReporterAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// ---------- Cases (a submitted report) ----------
model Case {
  id                  String     @id // public case ID, e.g. SS-7K2Q-9MPD
  categoryId          Int
  mode                ReportMode
  ciphertext          String // report content, encrypted in the browser
  nonce               String
  fingerprint         String // SHA-256 of the stored ciphertext
  aboutOther          Boolean    @default(false) // reported by a witness
  status              CaseStatus @default(RECEIVED)
  assignedHandlerId   String?
  submittedAt         DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lastHandlerActionAt DateTime?

  category        Category          @relation(fields: [categoryId], references: [id])
  assignedHandler User?             @relation("AssignedHandler", fields: [assignedHandlerId], references: [id])
  access          CaseAccess?
  keys            ReportKey[]
  exclusions      Exclusion[]
  recusals        Recusal[]
  messages        Message[]
  notes           CaseNote[]
  attachments     Attachment[]
  closures        ClosureApproval[]

  @@index([assignedHandlerId])
  @@index([status])
}

// How the reporter's browser proves it owns a case: a per-case key derived from the account's master key.
// The server stores only a hash of it (authVerifier); salt is unused since accounts were introduced.
model CaseAccess {
  caseId            String  @id
  salt              String // per-case salt for key derivation in the browser
  authVerifier      String // Argon2id hash of an auth key derived from the passphrase
  reporterPublicKey String // per-case key: replies to the reporter are sealed to this
  reporterSealedKey String? // the report's content key, sealed to the reporter's per-case key
  contactEnc        String? // optional contact email, encrypted
  case              Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

// The report's content key, sealed separately to each eligible handler
model ReportKey {
  id        String @id @default(uuid())
  caseId    String
  handlerId String
  sealedKey String
  case      Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  handler   User   @relation(fields: [handlerId], references: [id])

  @@unique([caseId, handlerId])
}

model Exclusion {
  id        String   @id @default(uuid())
  caseId    String
  handlerId String
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  handler   User     @relation(fields: [handlerId], references: [id])

  @@unique([caseId, handlerId])
}

model Recusal {
  id        String   @id @default(uuid())
  caseId    String
  handlerId String
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  handler   User     @relation(fields: [handlerId], references: [id])

  @@unique([caseId, handlerId])
}

model ClosureApproval {
  id             String         @id @default(uuid())
  caseId         String
  requestedById  String
  approvedById   String?
  status         ApprovalStatus @default(PENDING)
  previousStatus CaseStatus
  requestedAt    DateTime       @default(now())
  decidedAt      DateTime?
  case           Case           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  requestedBy    User           @relation("Requester", fields: [requestedById], references: [id])
  approvedBy     User?          @relation("Approver", fields: [approvedById], references: [id])
}

model Message {
  id         String     @id @default(uuid())
  caseId     String
  senderType SenderType
  handlerId  String?
  ciphertext String
  nonce      String
  keys       Json // { reporter: sealedKey, <handlerId>: sealedKey, ... }
  createdAt  DateTime   @default(now())
  case       Case       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  handler    User?      @relation(fields: [handlerId], references: [id])
}

// Internal notes: insert-only (no update/delete routes exist)
model CaseNote {
  id         String   @id @default(uuid())
  caseId     String
  handlerId  String
  ciphertext String
  nonce      String
  keys       Json
  createdAt  DateTime @default(now())
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  handler    User     @relation(fields: [handlerId], references: [id])
}

model Attachment {
  id          String   @id @default(uuid())
  caseId      String?
  mimeType    String
  kind        String   @default("file") // "image" | "pdf" | "voice"
  size        Int
  fingerprint String   @default("") // SHA-256 of the stored ciphertext
  purpose     String   @default("evidence") // "evidence" | "message" (a voice note sent in a conversation)
  ciphertext  Bytes // metadata stripped and encrypted in the browser
  nonce       String
  createdAt   DateTime @default(now())
  case        Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model ReplyTemplate {
  id    Int    @id @default(autoincrement())
  title String
  body  String
}

// Tamper-evident audit log: each row stores the hash of the previous row.
// The app's database role gets INSERT/SELECT only (see prisma/sql/audit_role.sql).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  actorType  String // REPORTER | HANDLER | ADMIN | SYSTEM
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  details    Json?
  prevHash   String
  hash       String

  @@index([targetType, targetId])
}
